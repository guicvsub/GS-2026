# Copie para .env e TROQUE as senhas. O .env está no .gitignore e nunca vai para o repositório.

# Linux: use o resultado de `id -u`. Windows/Mac: deixe 50000.
AIRFLOW_UID=50000

# Banco de metadados do Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=airflow

# Banco curado (consumido pelo MVP)
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_USER=citizentech
MYSQL_PASSWORD=troque-esta-senha-app

# Login da interface do Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha-admin

# Opcional: outra fonte GTFS (ex. outra cidade piloto)
# GTFS_URL=https://files.mobilitydatabase.org/mdb-8/latest.zip
